node_modules/
.next/
.env*

# export/reference/ is deliberately TRACKED, not ignored. It is the only input
# build_site.py can rebuild www/ from, and it cannot be re-fetched once the live
# WordPress host goes away at cutover. While it was ignored it lived on exactly
# one laptop with no backup, and four category page/2 snapshots had already been
# lost that way: they were captured and listed in export/pagination-urls.txt,
# then vanished, so those pages 404'd until they were re-captured.

# QA screenshots are regenerable from the built site, so these stay ignored.
export/screenshots/

# Large A/V stays out of the deploy and out of git: ~2.4GB across 93 files, and
# four of them are over GitHub's 100MB per-file hard limit. They now live in the
# dc-website-media Vercel Blob store (team develop-coaching, region lhr1,
# public), and vercel.json redirects /wp-content/uploads/*.mp3|mp4 there with
# paths mirrored 1:1. That no longer depends on the live WordPress host, so it
# survives cutover. Blob is the copy of record for these; the local files under
# www/ are a working archive, so if you re-encode or add one, upload it to the
# store too or the site will keep serving the old version.
www/wp-content/uploads/**/*.mp3
www/wp-content/uploads/**/*.mp4
.vercel

# Large video also lives in Blob, not Git (GitHub rejects >100MB)
www/wp-content/uploads/**/*.mov
